datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

// ==========================================
// 1. IDENTITY, ROLES & PLATFORM MULTI-TENANCY
// ==========================================

enum UserRole {
  SUPER_ADMIN
  OWNER
  OPERATOR
}

enum WorkspaceType {
  CULTIVATOR   // Blueprint A: Pembudidaya Air Tawar
  DISTRIBUTOR  // Blueprint B: Distributor Rantai Pasok
  HYBRID       // Terpadu (Hulu - Hilir)
}

enum WorkspaceStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum SubscriptionTier {
  FREE_STARTER
  PRO_GROWER
  ENTERPRISE_HUB
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  fullName         String
  phoneNumber      String?
  role             UserRole          @default(OPERATOR)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  workspaces              WorkspaceMember[]
  auditLogs               AuditLog[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  tokenHash      String   @unique
  tenantId       String?
  role           String
  membershipRole String
  land           String   @default("workspace")
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Workspace {
  id               String            @id @default(cuid())
  slug             String            @unique
  name             String
  businessType     WorkspaceType     @default(CULTIVATOR)
  status           WorkspaceStatus   @default(ACTIVE)
  tier             SubscriptionTier  @default(FREE_STARTER)
  expiresAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  members          WorkspaceMember[]
  auditLogs        AuditLog[]

  // Domain Relations - Blueprint A (Cultivator OS)
  ponds            Pond[]
  aquaCycles       AquaCycle[]
  waterQualityLogs WaterQualityLog[]

  // Domain Relations - Blueprint B (Supply Chain / ERP)
  productCategories ProductCategory[]
  products         Product[]
  partners         Partner[]
  transactions     Transaction[]
  inventoryBatches InventoryBatch[]
  deliveryOrders   DeliveryOrder[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        UserRole  @default(OPERATOR)
  joinedAt    DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String?
  userId      String?
  action      String
  entity      String
  entityId    String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ==========================================
// 2. BLUEPRINT A: CULTIVATOR OS (PEMBUDIDAYA)
// ==========================================

enum PondType {
  BIOFLOK
  TERPAL_BULAT
  TERPAL_KOTAK
  TANAH
  BETON
}

enum CycleStatus {
  PLANNED
  ACTIVE
  HARVEST_PARTIAL
  HARVESTED
  CLOSED
}

enum FishSpecies {
  LELE
  NILA_HITAM
  NILA_MERAH
  PATIN
  GURAME
}

model Pond {
  id          String      @id @default(cuid())
  workspaceId String
  code        String      // Contoh: K-01, FLOK-A
  name        String
  pondType    PondType    @default(BIOFLOK)
  diameter    Float?      // Meter (jika bulat)
  length      Float?      // Meter (jika persegi)
  width       Float?      // Meter (jika persegi)
  depth       Float       @default(1.0) // Meter
  volumeM3    Float       // Volume air efektif (m³)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cycles      AquaCycle[]

  @@unique([workspaceId, code])
  @@map("ponds")
}

model AquaCycle {
  id                String            @id @default(cuid())
  workspaceId       String
  pondId            String
  cycleCode         String            // e.g., CYC-2026-08-001
  status            CycleStatus       @default(ACTIVE)
  species           FishSpecies       @default(LELE)

  // Data Tebar Awal
  startDate         DateTime          @default(now())
  initialSeedCount  Int               // Total bibit ditebar (ekor)
  initialAvgWeightG Float             // Bobot rata-rata awal per ekor (gram)
  initialTotalKg    Float             // Total bobot awal (kg)
  seedPricePerItem  Decimal           @default(0) // Harga bibit per ekor (Rp)

  // Target & Proyeksi
  targetHarvestDays Int               @default(90) // Target lama siklus (hari)
  targetFcr         Float             @default(1.1) // Target Feed Conversion Ratio
  targetHarvestKg   Float             @default(0)   // Target total tonase (kg)
  targetSurvivalPct Float             @default(85.0)// Target Survival Rate (%)

  // Hasil Aktual & Penutupan Siklus
  endDate           DateTime?
  finalTotalHarvestKg Float?          // Total panen aktual (kg)
  finalFcr          Float?            // FCR Aktual
  finalSurvivalPct  Float?            // SR Aktual (%)
  totalFeedKg       Float             @default(0) // Akumulasi pakan terpakai (kg)
  totalMortality    Int               @default(0) // Akumulasi kematian (ekor)
  totalCostRp       Decimal           @default(0) // Total Biaya Operasional (Pakan, Benih, Probiotik, Listrik)
  totalRevenueRp    Decimal           @default(0) // Total Penjualan Ikan Panen
  netProfitRp       Decimal           @default(0) // Laba / Rugi Bersih

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pond              Pond              @relation(fields: [pondId], references: [id], onDelete: Restrict)
  feedLogs          FeedLog[]
  mortalityLogs     MortalityLog[]
  samplingLogs      SamplingLog[]
  harvestLogs       HarvestLog[]
  waterQualityLogs  WaterQualityLog[]
  harvestSummary    HarvestSummary?

  @@unique([workspaceId, cycleCode])
  @@map("aqua_cycles")
}

model FeedLog {
  id          String     @id @default(cuid())
  cycleId     String
  logDate     DateTime   @default(now())
  feedType    String     // e.g., "PF-1000", "LP-2", "781-1"
  feedTime    String     // "PAGI" | "SIANG" | "SORE" | "MALAM"
  amountKg    Float      // Berat pakan diberikan (kg)
  costPerKg   Decimal    @default(0) // Harga pakan per kg
  notes       String?
  createdAt   DateTime   @default(now())

  cycle       AquaCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@map("feed_logs")
}

model MortalityLog {
  id          String     @id @default(cuid())
  cycleId     String
  logDate     DateTime   @default(now())
  deathCount  Int        // Jumlah ikan mati (ekor)
  cause       String?    // e.g., "Kualitas Air Drop", "Koreng / Bakteri", "Kondisi Pasca Sampling"
  createdAt   DateTime   @default(now())

  cycle       AquaCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@map("mortality_logs")
}

model SamplingLog {
  id             String    @id @default(cuid())
  cycleId        String
  samplingDate   DateTime  @default(now())
  ageDay         Int       // Hari Ke- (DOC - Day of Culture)
  sampleWeightG  Float     // Rata-rata berat sampel per ekor (gram)
  sampleLengthCm Float?    // Rata-rata panjang (cm)
  estimatedPop   Int       // Estimasi populasi hidup (ekor)
  currentBiomassKg Float   // Estimasi total biomassa di kolam (kg)
  currentFcr     Float?    // FCR saat sampling dihitung
  notes          String?
  createdAt      DateTime  @default(now())

  cycle          AquaCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@map("sampling_logs")
}

model HarvestLog {
  id             String    @id @default(cuid())
  cycleId        String
  harvestDate    DateTime  @default(now())
  isPartial      Boolean   @default(false) // Panen sebagian atau panen total
  totalKg        Float     // Berat total panen (kg)
  fishCount      Int?      // Estimasi total ekor
  sizeGrade      String    // e.g., "Isi 8-10 ekor/kg", "Isi 5-6 ekor/kg"
  pricePerKg     Decimal   // Harga jual per kg (Rp)
  totalRevenue   Decimal   // Total harga (totalKg * pricePerKg)
  buyerPartnerId String?   // Terhubung ke Partner/Offtaker jika ada
  notes          String?
  createdAt      DateTime  @default(now())

  cycle          AquaCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@map("harvest_logs")
}

model HarvestSummary {
  id          String   @id @default(cuid())
  cycleId     String   @unique
  fcr         Float?
  srPct       Float?
  hpp         Float?
  profit      Decimal?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cycle       AquaCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
}

model WaterQualityLog {
  id            String     @id @default(cuid())
  workspaceId   String
  cycleId       String?
  logDate       DateTime   @default(now())
  phLevel       Float      // Optimal 6.5 - 8.0
  temperatureC  Float      // Optimal 26 - 30 °C
  dissolvedO2   Float?     // DO (mg/L), Optimal > 4 mg/L
  ammoniaPpm    Float?     // Amonia (mg/L)
  waterColor    String?    // e.g., "Hijau Terang", "Coklat Teh", "Bening"
  status        String     @default("NORMAL") // "OPTIMAL" | "WARNING" | "CRITICAL"
  notes         String?
  createdAt     DateTime   @default(now())

  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cycle         AquaCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@map("water_quality_logs")
}

// ==========================================
// 3. BLUEPRINT B: SUPPLY CHAIN HUB (ERP DISTRIBUTOR)
// ==========================================

enum CategoryType {
  SEED_BENIH      // Benih/Bibit Ikan
  FEED_PAKAN      // Pakan Ikan (Pelet apung, tenggelam)
  FRESH_FISH      // Ikan Segar Hasil Panen
  PROCESSED_FISH  // Ikan Olahan / Frozen
  EQUIPMENT       // Pompa, Aerator, Terpal, Obat/Probiotik
}

enum PartnerType {
  SUPPLIER
  BUYER_CUSTOMER
  OFFTAKER
}

enum TransactionType {
  PURCHASE_IN   // Pembelian Masuk (Restock)
  SALE_OUT      // Penjualan Keluar
  EXPENSE_OPEX  // Biaya Operasional Toko/Gudang
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  TERM_OF_PAYMENT // Pembayaran Tempo / Piutang
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model ProductCategory {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  categoryType CategoryType @default(FEED_PAKAN)
  createdAt   DateTime     @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([workspaceId, name])
  @@map("product_categories")
}

model Product {
  id                String            @id @default(cuid())
  workspaceId       String
  categoryId        String
  sku               String            // Barcode/Kode Barang
  name              String
  unit              String            // "sak", "kg", "ekor", "box", "liter"
  basePrice         Decimal           @default(0) // Harga modal
  salePrice         Decimal           @default(0) // Harga jual standar
  minStock          Float             @default(5) // Batas minimum peringatan stok habis
  currentStock      Float             @default(0)
  isActive          Boolean           @default(true)
  specDetails       Json?             // JSON spesifikasi: { proteinPct: 32, pelletSizeMm: 2, sizeCm: "7-8" }
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category          ProductCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  batches           InventoryBatch[]
  itemDetails       TransactionItem[]
  deliveryOrderLines DeliveryOrderLine[]

  @@unique([workspaceId, sku])
  @@map("products")
}

model InventoryBatch {
  id          String      @id @default(cuid())
  workspaceId String
  productId   String
  batchNumber String      // e.g., BATCH-202608-01
  initialQty  Float
  remainingQty Float
  expiredDate DateTime?
  receivedDate DateTime   @default(now())
  buyPrice    Decimal     @default(0)
  storageNote String?     // e.g., "Gudang A - Rak 2", "Cold Storage -18°C"
  createdAt   DateTime    @default(now())

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory_batches")
}

model Partner {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  partnerType PartnerType   @default(BUYER_CUSTOMER)
  phoneNumber String?
  email       String?
  address     String?
  outstandingCredit Decimal @default(0) // Total Piutang / Hutang Berjalan
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  deliveryOrders DeliveryOrder[]

  @@map("partners")
}

model Transaction {
  id             String            @id @default(cuid())
  workspaceId    String
  partnerId      String?
  invoiceNumber  String            // e.g., INV-202608-001
  type           TransactionType   @default(SALE_OUT)
  totalAmount    Decimal           @default(0)
  paidAmount     Decimal           @default(0)
  paymentStatus  PaymentStatus     @default(PAID)
  paymentMethod  PaymentMethod     @default(CASH)
  dueDate        DateTime?         // Jatuh tempo jika tempo/kredit
  transactionDate DateTime         @default(now())
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  partner        Partner?          @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  items          TransactionItem[]
  deliveryOrders DeliveryOrder[]

  @@unique([workspaceId, invoiceNumber])
  @@map("transactions")
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  productId     String
  quantity      Float
  unitPrice     Decimal
  subtotal      Decimal     // quantity * unitPrice
  discount      Decimal     @default(0)

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("transaction_items")
}

model DeliveryOrder {
  id             String       @id @default(cuid())
  workspaceId    String
  transactionId  String
  partnerId      String
  doNumber       String       // Nomor Surat Jalan: SJ-202608-001
  driverName     String?
  vehicleNumber  String?      // No Polisi Armada
  status         String       @default("IN_TRANSIT") // "DRAFT" | "IN_TRANSIT" | "DELIVERED"
  departureDate  DateTime     @default(now())
  receivedDate   DateTime?
  recipientName  String?
  notes          String?
  createdAt      DateTime     @default(now())

  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transaction    Transaction  @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  partner        Partner      @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  lines          DeliveryOrderLine[]

  @@unique([workspaceId, doNumber])
  @@map("delivery_orders")
}

model DeliveryOrderLine {
  id               String        @id @default(cuid())
  deliveryOrderId  String
  productId        String
  qty              Float
  uom              String        @default("KG")
  price            Decimal?
  subtotal         Decimal?
  notes            String?
  deliveryOrder    DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@map("delivery_order_lines")
}