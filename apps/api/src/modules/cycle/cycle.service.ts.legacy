import { Injectable } from '@nestjs/common';
import { InjectRepository } from '@nestjs/typeorm';
import { Repository } from 'typeorm';
import { Cycle } from './cycle.entity';

@Injectable()
export class CycleService {
  constructor(
    @InjectRepository(Cycle)
    private readonly cycleRepository: Repository<Cycle>,
  ) {}

  async openCycle(cycle: Cycle): Promise<Cycle> {
    // Check if there is already an active cycle for the same pond
    const existingActiveCycle = await this.cycleRepository.findOne({
      where: { pondId: cycle.pondId, status: 'ACTIVE' },
    });
    if (existingActiveCycle) {
      throw new Error('Only one active cycle per pond at the same time');
    }

    // Set the status to ACTIVE
    cycle.status = 'ACTIVE';

    return this.cycleRepository.save(cycle);
  }

  async closeCycle(cycle: Cycle): Promise<Cycle> {
    // Check if the cycle is already closed
    if (cycle.status === 'CLOSED') {
      throw new Error('Closed cycle cannot be reopened');
    }

    // Set the status to CLOSED
    cycle.status = 'CLOSED';

    return this.cycleRepository.save(cycle);
  }
}
