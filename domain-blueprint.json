{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User account and platform role metadata",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "OWNER", "OPERATOR"] },
        "createdAt": { "type": "string" }
      }
    },
    "workspaces": {
      "title": "Workspace / Tenant",
      "description": "Tenant entity containing core business settings and associations",
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
