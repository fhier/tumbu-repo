      }
    },
    "distributor": {
      "title": "Distributor/ERP Domain",
      "description": "Inventory, supply chain, and commercial transaction entities",
      "entities": {
        "products": { "description": "Catalog and SKUs" },
        "inventory": { "description": "Batches and stock movements" },
        "partners": { "description": "Suppliers, buyers, and offtakers" },
        "transactions": { "description": "Sales, purchases, and expense invoicing" }
