# ─────────────────────────────────────────────────────────────
# TUMBU — Environment Variables Template
# Salin file ini ke .env dan isi nilainya
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://tumbu:tumbu_dev_password@localhost:5432/tumbu
POSTGRES_PASSWORD=tumbu_dev_password

# ── API Server ───────────────────────────────────────────────
API_PORT=3001

# ── Next.js Web ──────────────────────────────────────────────
# URL publik yang diakses browser (tanpa trailing slash)
NEXT_PUBLIC_API_URL=http://localhost

# URL internal Next.js → API (dalam Docker Compose, pakai nama service)
# Development: http://127.0.0.1:3001
# Docker Compose: http://api:3001
INTERNAL_API_URL=http://127.0.0.1:3001

# ── Auth & Admin ─────────────────────────────────────────────
ADMIN_PASSWORD=tumbu123
DEMO_USER_PASSWORD=TumbuDemo123!
AUTH_DISABLED=0

# ── CORS ─────────────────────────────────────────────────────
# Development: * atau http://localhost:3000
# Production: domain/IP Anda, contoh: http://192.168.1.100
CORS_ORIGIN=*
CORS_ALLOW_TRYCLOUDFLARE=1

# ── Environment Mode ─────────────────────────────────────────
# Development: (kosongkan)
# Production: production
TUMBU_ENV=
REQUIRE_STRICT_SECRETS=0

# ── Payment ──────────────────────────────────────────────────
# "stub" untuk development/testing, "xendit" untuk production
PAYMENT_PROVIDER=stub
STUB_WEBHOOK_SECRET=stub-dev-secret
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=