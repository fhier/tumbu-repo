# ─────────────────────────────────────────────────────────────
# TUMBU — Production Environment Template
# Deploy ke: Linux/Ubuntu server via Docker Compose
#
# PETUNJUK:
# 1. Salin file ini ke .env di server: cp .env.production.example .env
# 2. Isi SETIAP nilai dengan aman (jangan pakai nilai default!)
# 3. Simpan .env di server, JANGAN commit ke Git
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# Ganti PASSWORD_KUAT_ANDA dengan password minimal 16 karakter
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_MINIMAL_16_KARAKTER
DATABASE_URL=postgresql://tumbu:GANTI_DENGAN_PASSWORD_KUAT_MINIMAL_16_KARAKTER@postgres:5432/tumbu

# ── API Server ───────────────────────────────────────────────
API_PORT=3001

# ── Next.js Web ──────────────────────────────────────────────
# Ganti dengan IP lokal server Anda (contoh: http://192.168.1.100)
NEXT_PUBLIC_API_URL=http://IP_SERVER_ANDA

# Internal Docker Compose network — nama service API
INTERNAL_API_URL=http://api:3001

# ── Auth & Admin ─────────────────────────────────────────────
# WAJIB: minimal 12 karakter, bukan password default
ADMIN_PASSWORD=GANTI_ADMIN_PASSWORD_KUAT
DEMO_USER_PASSWORD=GANTI_DEMO_PASSWORD_KUAT
AUTH_DISABLED=0

# ── CORS ─────────────────────────────────────────────────────
# Ganti dengan IP/domain server Anda — JANGAN pakai * di production
CORS_ORIGIN=http://IP_SERVER_ANDA
CORS_ALLOW_TRYCLOUDFLARE=0

# ── Environment Mode ─────────────────────────────────────────
TUMBU_ENV=production
REQUIRE_STRICT_SECRETS=1

# ── Payment ──────────────────────────────────────────────────
# "stub" jika belum pakai Xendit, "xendit" jika sudah
PAYMENT_PROVIDER=stub

# WAJIB: minimal 16 karakter, bukan "stub-dev-secret"
STUB_WEBHOOK_SECRET=GANTI_WEBHOOK_SECRET_MINIMAL_16_KARAKTER

# Isi jika PAYMENT_PROVIDER=xendit
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
